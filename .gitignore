/test/c/build/
/test/qpy_compat/dev-files
/test/qpy_compat/forward-qpy-files

# Distribution / packaging
/build/
/dist/
/wheelhouse/
*.egg-info/

# Testing tools and reports
/.asv/
/.coverage
/.coverage.*
/.hypothesis/
/.stestr/
/.tox/

# Sphinx documentation
/docs/_build
/docs/stubs
/docs/locale
/docs/xml

# Notebook testing images
/test/visual/mpl/circuit/circuit_results/*.png
/test/visual/mpl/circuit/circuit_results/*.json
/test/visual/mpl/graph/graph_results/*.png
/test/visual/mpl/graph/graph_results/*.json
